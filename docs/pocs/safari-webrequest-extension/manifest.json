{
  "manifest_version": 3,
  "name": "Cueward WebRequest PoC",
  "description": "Observe requests to a local test page in Safari.",
  "version": "0.1.0",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  }
}
